{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pipeline_manifest/v1",
  "title": "Pipeline Reproducibility Manifest",
  "description": "Provenance trail written by .claude/scripts/qa/pipeline_manifest.py to _workspace/pipeline_manifest.json.",
  "type": "object",
  "required": ["schema", "phases"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "pipeline_manifest/v1" },
    "harness_version": { "type": "string" },
    "trial": { "type": "string" },
    "created_utc": { "type": "string", "format": "date-time" },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "agent", "model", "timestamp_utc"],
        "additionalProperties": false,
        "properties": {
          "phase": { "type": "string" },
          "agent": { "type": "string" },
          "model": { "type": "string" },
          "timestamp_utc": { "type": "string", "format": "date-time" },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string" },
                "sha256": { "type": ["string", "null"] }
              }
            }
          },
          "output": {
            "type": ["object", "null"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": ["string", "null"] }
            }
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
