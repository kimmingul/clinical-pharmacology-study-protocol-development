# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.venv/
venv/

# Build artifacts — the deployable plugin zip is published as a GitHub Release
# asset, not committed. (The plugin/ tree itself is the build output of
# sync_plugin.sh; keep it tracked only if distributing via git source.)
plugin/**/*.zip
*.zip

# Generated presentation deck (rebuild: python docs/build_presentation_pptx.py)
*.pptx

# 런타임 워크스페이스 (실행 시 생성/갱신되는 산출물)
/_workspace/

# 에디터/IDE
.vscode/
.idea/
*.swp
*~

# 환경
.env
.env.local

# OMC 런타임 상태 (보고서/연구 산출물은 .omc/research/ 아래에 보존)
/.omc/*
!/.omc/research/
/plugin/.omc/

# git worktree 격리 작업공간 (구현 중 생성, 저장소에 커밋하지 않음)
/.claude/worktrees/

# Subagent-Driven Development 진행 원장·브리프·리뷰 패키지 (스크래치)
/.superpowers/

# 외부 모델 협의체(xllm) 산출물 — 참고 자료이며 저장소 이력에 남기지 않음
/.xllm/
