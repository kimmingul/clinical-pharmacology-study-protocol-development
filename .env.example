# Environment variables for optional Web API access.
# Copy to `.env` (which is git-ignored) and fill in. NEVER commit real keys.

# data.go.kr OpenAPI service key for MFDS clinical-trial approval search
# (optional — the WebFetch searchClinic recipe works without a key, but the
#  official OpenAPI is more stable for large queries). Register a free account
# at https://www.data.go.kr and request API 15056835.
MFDS_SERVICE_KEY=

# openFDA API key (optional — raises the unauthenticated 1,000 req/day limit).
# Free key: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
